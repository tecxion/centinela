<Project>
  <!-- FFmpeg native libraries only for the target system: Windows DLLs for win-* (or a RID-less build
       on Windows), Linux .so files for linux-* (or a RID-less build on Linux), macOS .dylib files of
       ffmpeg/<rid>/lib for osx-* (or a RID-less build on macOS, with the SDK's own RID). -->
  <PropertyGroup>
    <_CentinelaFFmpegWindows Condition="('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))) Or $(RuntimeIdentifier.StartsWith('win'))">true</_CentinelaFFmpegWindows>
    <_CentinelaFFmpegLinux Condition="('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux'))) Or $(RuntimeIdentifier.StartsWith('linux'))">true</_CentinelaFFmpegLinux>
    <_CentinelaFFmpegMacRid Condition="$(RuntimeIdentifier.StartsWith('osx'))">$(RuntimeIdentifier)</_CentinelaFFmpegMacRid>
    <_CentinelaFFmpegMacRid Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">$(NETCoreSdkRuntimeIdentifier)</_CentinelaFFmpegMacRid>
  </PropertyGroup>
  <ItemGroup Condition="'$(CopyFFmpeg)' == 'true' And '$(_CentinelaFFmpegWindows)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)ffmpeg\bin\*.dll"
          Link="ffmpeg\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(CopyFFmpeg)' == 'true' And '$(_CentinelaFFmpegLinux)' == 'true'">
    <!-- Only the soname files (libavcodec.so.N ...), which are what FFmpegLoader opens.
         The full-version files (libavcodec.so.N.x.y) and the bare .so names are symlink twins:
         copying them too would duplicate every library, since the copy follows the links. -->
    <None Include="$(MSBuildThisFileDirectory)ffmpeg\lib\*.so.*"
          Exclude="$(MSBuildThisFileDirectory)ffmpeg\lib\*.so.*.*"
          Link="ffmpeg\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(CopyFFmpeg)' == 'true' And '$(_CentinelaFFmpegMacRid)' != ''">
    <!-- tools/get-ffmpeg-mac.sh leaves only the lib<name>.<N>.dylib files, which are what FFmpegLoader opens. -->
    <None Include="$(MSBuildThisFileDirectory)ffmpeg\$(_CentinelaFFmpegMacRid)\lib\*.dylib"
          Link="ffmpeg\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>
</Project>
