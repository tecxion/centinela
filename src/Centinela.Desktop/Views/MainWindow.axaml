<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Centinela.Desktop.ViewModels"
        xmlns:views="using:Centinela.Desktop.Views"
        x:Class="Centinela.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Centinela" Width="1280" Height="800"
        Icon="/Assets/centinela.ico">
    <Window.Styles>
        <!-- A toolbar separator: a thin vertical line. -->
        <Style Selector="Border.separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="3,2" />
            <Setter Property="Background" Value="#5A5A60" />
        </Style>
    </Window.Styles>
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Importar JSON…" Click="Import_Click" />
                <MenuItem Header="_Exportar JSON…" Click="Export_Click" />
                <MenuItem Header="_Carpeta de copia automática…" Click="BackupFolder_Click" />
                <Separator />
                <MenuItem Header="_Salir" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Ver">
                <!-- The menu flips IsChecked itself; TwoWay because MenuItem.IsChecked binds OneWay by default. -->
                <MenuItem Header="Mostrar _estadísticas" ToggleType="CheckBox"
                          IsChecked="{Binding ShowStats, Mode=TwoWay}" />
                <Separator />
                <MenuItem Header="_Opciones de avisos…" Click="NotificationOptions_Click" />
            </MenuItem>
            <MenuItem Header="A_yuda">
                <MenuItem Header="_Manual" Click="Manual_Click" />
                <MenuItem Header="_Licencia" Click="License_Click" />
                <MenuItem Header="_Soporte" Click="Support_Click" />
                <Separator />
                <MenuItem Header="_Buscar actualizaciones…" Click="Updates_Click" />
                <MenuItem Header="_Acerca de Centinela" Click="About_Click" />
            </MenuItem>
        </Menu>
        <StackPanel x:Name="TopBar" DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4" Spacing="6">
            <Button Content="➕ Añadir cámara" Click="AddCamera_Click" />
            <Button Content="🔍 Buscar en red" Click="Discover_Click" />
            <Border Classes="separator" />
            <TextBlock Text="Vista:" VerticalAlignment="Center" />
            <ComboBox MinWidth="240" ItemsSource="{Binding LayoutLabels}" SelectedIndex="{Binding LayoutIndex}" />
            <Border Classes="separator" />
            <Button Content="📁 Grabaciones" Click="OpenRecordings_Click" />
            <Button Content="{Binding RecordAllText}" Click="RecordAll_Click" />
        </StackPanel>
        <Border x:Name="BottomBar" DockPanel.Dock="Bottom" Padding="8,3" Background="{StaticResource BarBackground}">
            <DockPanel>
                <!-- «Movimiento» opens the motion log; «Registro» the error log. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                    <Button x:Name="MotionLogButton" Content="Movimiento" Padding="8,0" ToolTip.Tip="Registro de movimiento"
                            Click="OpenMotionLog_Click" />
                    <Button x:Name="LogButton" Content="Registro" Padding="8,0" ToolTip.Tip="Registro de errores"
                            Click="OpenLog_Click" />
                </StackPanel>
                <!-- Clicking the message shows its file or folder, when it has one. -->
                <TextBlock Text="{Binding StatusText}" Cursor="Hand" Background="Transparent" HorizontalAlignment="Left"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           PointerReleased="StatusText_PointerReleased" />
            </DockPanel>
        </Border>
        <Grid>
            <Grid x:Name="TileGrid" />
            <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No hay cámaras" Foreground="#AAAAAA" FontSize="20" HorizontalAlignment="Center" />
                <Button Content="Añade tu primera cámara" Margin="0,12,0,0" Padding="12,6" HorizontalAlignment="Center"
                        Click="AddCamera_Click" />
            </StackPanel>
            <!-- Notices: bottom-right, over the cameras. -->
            <views:ToastHost x:Name="Toasts" />
        </Grid>
    </DockPanel>
</Window>
