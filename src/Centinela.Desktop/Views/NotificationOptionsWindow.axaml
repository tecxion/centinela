<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Centinela.Desktop.ViewModels"
        xmlns:svc="using:Centinela.Desktop.Services.Notifications"
        x:Class="Centinela.Desktop.Views.NotificationOptionsWindow"
        Title="Opciones de avisos" Width="820" Height="520" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/centinela.ico">
    <Window.Styles>
        <!-- A quiet-hours time that is not HH:mm: red border, also while focused or hovered. -->
        <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="Red" />
        </Style>
        <Style Selector="TextBox.invalid:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="Red" />
        </Style>
        <Style Selector="TextBox.invalid:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="Red" />
        </Style>
        <Style Selector="Grid.header > TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0" />
        </Style>
    </Window.Styles>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Aceptar" IsDefault="True" Width="90" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="Cancelar" IsCancel="True" Width="90" Click="Cancel_Click" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <CheckBox x:Name="SoundLostBox" Content="Sonar al perder una conexión" Margin="0,0,0,6" />
            <CheckBox x:Name="SoundMotionBox" Content="Sonar al detectar movimiento" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="QuietBox" Content="Horas de silencio" VerticalAlignment="Center" />
                <TextBlock Text="desde" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox x:Name="QuietFromBox" Width="60" MinWidth="60" MaxLength="5" VerticalContentAlignment="Center"
                         ToolTip.Tip="Hora con formato HH:mm (por ejemplo 23:00)" />
                <TextBlock Text="hasta" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox x:Name="QuietToBox" Width="60" MinWidth="60" MaxLength="5" VerticalContentAlignment="Center"
                         ToolTip.Tip="Hora con formato HH:mm (por ejemplo 07:00)" />
            </StackPanel>
            <TextBlock x:Name="Error" Foreground="Red" TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,0"
                       Text="La detección mantiene abierta la conexión de baja calidad de cada cámara vigilada, también con la app en la bandeja." />
        </StackPanel>
        <!-- The table: a header row, then one Grid row per camera with the same columns. -->
        <Border BorderBrush="Gray" BorderThickness="1">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Classes="header" Height="32" Background="#22888888"
                      ColumnDefinitions="*,90,110,100,140,160">
                    <TextBlock Grid.Column="0" Text="Cámara" />
                    <TextBlock Grid.Column="1" Text="Detección" />
                    <TextBlock Grid.Column="2" Text="Sensibilidad" />
                    <TextBlock Grid.Column="3" Text="Espera" />
                    <TextBlock Grid.Column="4" Text="Avisos de conexión" />
                    <TextBlock Grid.Column="5" Text="Avisos de movimiento" />
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="RowsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NotificationOptionsRow">
                                <Border BorderBrush="#33888888" BorderThickness="0,0,0,1" Padding="0,3">
                                    <Grid ColumnDefinitions="*,90,110,100,140,160">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                                   Margin="6,0" TextTrimming="CharacterEllipsis" />
                                        <CheckBox Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding MotionEnabled}" />
                                        <ComboBox Grid.Column="2" MinWidth="80" Margin="6,0" VerticalAlignment="Center"
                                                  ItemsSource="{x:Static svc:NotificationOptions.Sensitivities}"
                                                  DisplayMemberBinding="{ReflectionBinding Label}"
                                                  SelectedItem="{Binding Sensitivity}" />
                                        <ComboBox Grid.Column="3" MinWidth="80" Margin="6,0" VerticalAlignment="Center"
                                                  ItemsSource="{x:Static svc:NotificationOptions.Cooldowns}"
                                                  DisplayMemberBinding="{ReflectionBinding Label}"
                                                  SelectedItem="{Binding Cooldown}" />
                                        <CheckBox Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding ConnectionAlerts}" />
                                        <CheckBox Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding MotionAlerts}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
