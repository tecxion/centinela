<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="using:Centinela.Desktop.Services.Discovery"
        x:Class="Centinela.Desktop.Views.DiscoveryDialog"
        Title="Buscar cámaras en la red" Width="680" Height="640" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/centinela.ico">
    <Window.Styles>
        <Style Selector="ListBox#DeviceList ListBoxItem">
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style Selector="ListBox#NetworksList ListBoxItem">
            <Setter Property="Padding" Value="6,2" />
        </Style>
    </Window.Styles>
    <DockPanel Margin="16">
        <!-- «Redes donde buscar» (a GroupBox in the Windows version). -->
        <Border DockPanel.Dock="Top" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Redes donde buscar" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ListBox x:Name="NetworksList" Height="110">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="d:NetworkItem">
                            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanUncheck}" Content="{Binding Label}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <TextBox x:Name="NewNetworkBox" VerticalContentAlignment="Center"
                             ToolTip.Tip="Si conoces la red de tus cámaras: 192.168.2.0/24, 192.168.2.* o 192.168.2.1-50" />
                    <Button Grid.Column="1" Content="Añadir red" Padding="10,3" Margin="8,0,0,0" Click="AddNetwork_Click" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="DetectButton" Content="📡 Detectar otras redes" Padding="10,4" Click="Detect_Click"
                            ToolTip.Tip="Pregunta a todas las direcciones de tu zona de red (unos 20–30 s) y añade las redes donde contesta alguna cámara" />
                    <Button Content="Marcar todas" Padding="10,4" Margin="8,0,0,0" Click="CheckAll_Click" />
                    <ProgressBar x:Name="DetectProgress" Width="160" MinWidth="160" Height="14" MinHeight="14" Margin="12,0,0,0"
                                 VerticalAlignment="Center" Minimum="0" Maximum="1" IsVisible="False" />
                </StackPanel>
                <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="La red de este PC se busca siempre. Si tus cámaras están en otra red (otra VLAN o red de invitados) y no sabes cuál, pulsa «Detectar otras redes»." />
            </StackPanel>
        </Border>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
            <Button x:Name="SearchButton" Content="🔍 Buscar" Padding="10,4" VerticalAlignment="Top" Click="Search_Click" />
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto,*">
                <TextBlock Text="Usuario" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="UserBox" Grid.Column="1" Margin="0,0,12,0" />
                <TextBlock Grid.Column="2" Text="Contraseña" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="PasswordInput" Grid.Column="3" PasswordChar="●" />
            </Grid>
            <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Tapo: la «Cuenta de cámara». Imou: admin + código de seguridad." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="AddButton" Content="Añadir seleccionada" Padding="10,4" Margin="0,0,8,0" IsDefault="True" Click="Add_Click" />
                <Button Content="Cerrar" Padding="10,4" IsCancel="True" Click="Close_Click" />
            </StackPanel>
        </StackPanel>
        <!-- The camera list (a GridView in the Windows version): a header row over rows with the same columns. -->
        <Grid ColumnDefinitions="120,160,190,100" DockPanel.Dock="Top" Margin="5,0,0,4">
            <TextBlock Text="IP" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="Nombre" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Modelo" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="Estado" FontWeight="SemiBold" />
        </Grid>
        <ListBox x:Name="DeviceList" BorderBrush="Gray" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="d:DiscoveryRow">
                    <Grid ColumnDefinitions="120,160,190,100">
                        <TextBlock Text="{Binding Host}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Hardware}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
