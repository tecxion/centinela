<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Centinela.Core"
        x:Class="Centinela.Desktop.Views.ErrorLogWindow"
        Title="Registro de errores" Width="900" Height="480" MinWidth="600" MinHeight="300"
        WindowStartupLocation="CenterOwner" Icon="/Assets/centinela.ico">
    <Window.Styles>
        <Style Selector="Grid.header > TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0" />
        </Style>
        <Style Selector="Grid.row > TextBlock">
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="ListBox#Rows > ListBoxItem">
            <Setter Property="Padding" Value="0,3" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Window.Styles>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Copiar" Padding="10,4" Margin="0,0,8,0" Click="Copy_Click"
                    ToolTip.Tip="Copia las filas seleccionadas (o todas si no hay ninguna seleccionada)" />
            <Button Content="Abrir carpeta" Padding="10,4" Margin="0,0,8,0" Click="OpenFolder_Click" />
            <Button Content="Limpiar" Padding="10,4" Click="Clear_Click"
                    ToolTip.Tip="Vacía la lista; los archivos de registro se conservan" />
        </StackPanel>
        <!-- The table: a header row, then one Grid row per entry with the same columns; newest first. -->
        <Border BorderBrush="Gray" BorderThickness="1">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Classes="header" Height="28" Background="#22888888"
                      ColumnDefinitions="110,140,150,240,*">
                    <TextBlock Grid.Column="0" Text="Hora" />
                    <TextBlock Grid.Column="1" Text="Cámara" />
                    <TextBlock Grid.Column="2" Text="Error" />
                    <TextBlock Grid.Column="3" Text="Título" />
                    <TextBlock Grid.Column="4" Text="Detalle" />
                </Grid>
                <ListBox x:Name="Rows" SelectionMode="Multiple" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="core:ErrorLogEntry">
                            <Grid Classes="row" ColumnDefinitions="110,140,150,240,*">
                                <TextBlock Grid.Column="0" Text="{Binding Time, StringFormat='{}{0:dd/MM HH:mm:ss}'}" />
                                <TextBlock Grid.Column="1" Text="{Binding Camera}" />
                                <TextBlock Grid.Column="2" Text="{Binding Kind}" />
                                <TextBlock Grid.Column="3" Text="{Binding Title}" />
                                <TextBlock Grid.Column="4" Text="{Binding Detail}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
