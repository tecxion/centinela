<Window x:Class="Centinela.App.MotionLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Centinela.App"
        Title="Registro de movimiento" Width="640" Height="480"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:MotionDurationConverter x:Key="Duration"/>
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Copiar" Padding="10,4" Margin="0,0,8,0" Click="Copy_Click"
                    ToolTip="Copia las filas seleccionadas (o todas si no hay ninguna seleccionada)"/>
            <Button Content="Abrir carpeta" Padding="10,4" Margin="0,0,8,0" Click="OpenFolder_Click"/>
            <Button Content="Vaciar" Padding="10,4" Click="Clear_Click"
                    ToolTip="Vacía la lista; los archivos de registro se conservan"/>
        </StackPanel>
        <DataGrid x:Name="EntriesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Hora" Binding="{Binding Start, StringFormat='dd/MM HH:mm:ss'}" Width="Auto"/>
                <DataGridTextColumn Header="Cámara" Binding="{Binding Camera}" Width="*"/>
                <DataGridTextColumn Header="Duración" Binding="{Binding Duration, Converter={StaticResource Duration}}" Width="Auto"/>
                <DataGridTextColumn Header="Cambio máx." Binding="{Binding Peak, StringFormat='0.0 %'}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
