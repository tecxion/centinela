<Window x:Class="Centinela.App.CameraQualityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calidad de la cámara" Width="720" Height="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8">
            Consulta a la cámara (sin cambiar nada) qué resolución, fps y bitrate usa y qué admite, por ONVIF y por la
            API de Dahua/Imou, con el usuario y la contraseña guardados.
        </TextBlock>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="RetryButton" Content="Consultar otra vez" Padding="10,4" Margin="0,0,8,0" Click="Retry_Click"/>
            <Button Content="Copiar" Padding="10,4" Margin="0,0,8,0" Click="Copy_Click"
                    ToolTip="Copia el informe (no incluye la contraseña)"/>
            <Button Content="Cerrar" Padding="10,4" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
        <TextBox x:Name="Report" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
