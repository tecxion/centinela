<Window x:Class="Centinela.App.DiscoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscar cámaras en la red" Width="680" Height="640" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <GroupBox DockPanel.Dock="Top" Header="Redes donde buscar" Padding="8" Margin="0,0,0,10">
            <StackPanel>
                <ListBox x:Name="NetworksList" Height="110">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanUncheck}" Content="{Binding Label}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewNetworkBox" VerticalContentAlignment="Center"
                             ToolTip="Si conoces la red de tus cámaras: 192.168.2.0/24, 192.168.2.* o 192.168.2.1-50"/>
                    <Button Grid.Column="1" Content="Añadir red" Padding="10,3" Margin="8,0,0,0" Click="AddNetwork_Click"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="DetectButton" Content="📡 Detectar otras redes" Padding="10,4" Click="Detect_Click"
                            ToolTip="Pregunta a todas las direcciones de tu zona de red (unos 20–30 s) y añade las redes donde contesta alguna cámara"/>
                    <Button Content="Marcar todas" Padding="10,4" Margin="8,0,0,0" Click="CheckAll_Click"/>
                    <ProgressBar x:Name="DetectProgress" Width="160" Height="14" Margin="12,0,0,0" Maximum="1" Visibility="Collapsed"/>
                </StackPanel>
                <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="La red de este PC se busca siempre. Si tus cámaras están en otra red (otra VLAN o red de invitados) y no sabes cuál, pulsa «Detectar otras redes»."/>
            </StackPanel>
        </GroupBox>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="SearchButton" Content="🔍 Buscar" Padding="10,4" Click="Search_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Usuario" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="UserBox" Grid.Column="1" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="2" Text="Contraseña" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <PasswordBox x:Name="PasswordInput" Grid.Column="3"/>
            </Grid>
            <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Tapo: la «Cuenta de cámara». Imou: admin + código de seguridad."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="AddButton" Content="Añadir seleccionada" Padding="10,4" Margin="0,0,8,0" IsDefault="True" Click="Add_Click"/>
                <Button Content="Cerrar" Padding="10,4" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
        <ListView x:Name="DeviceList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="IP" Width="120" DisplayMemberBinding="{Binding Host}"/>
                    <GridViewColumn Header="Nombre" Width="160" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Modelo" Width="190" DisplayMemberBinding="{Binding Hardware}"/>
                    <GridViewColumn Header="Estado" Width="100" DisplayMemberBinding="{Binding Status}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
