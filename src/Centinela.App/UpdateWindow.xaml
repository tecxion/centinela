<Window x:Class="Centinela.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actualizaciones" Width="520" Height="420" MinWidth="420" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="DownloadButton" Content="Descargar" MinWidth="90" Padding="8,2" Margin="0,0,8,0" Visibility="Collapsed"/>
            <Button x:Name="SkipButton" Content="Omitir esta versión" MinWidth="90" Padding="8,2" Margin="0,0,8,0" Visibility="Collapsed"/>
            <Button x:Name="RetryButton" Content="Volver a comprobar" MinWidth="90" Padding="8,2" Margin="0,0,8,0"/>
            <Button Content="Cerrar" MinWidth="90" Padding="8,2" IsCancel="True"/>
        </StackPanel>
        <CheckBox x:Name="AutoCheckBox" DockPanel.Dock="Bottom" Content="Comprobar al arrancar" Margin="0,12,0,0"/>
        <StackPanel>
            <TextBlock x:Name="InstalledText"/>
            <TextBlock x:Name="StatusText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"/>
            <TextBox x:Name="NotesBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Height="200" Margin="0,12,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </DockPanel>
</Window>
