<Window x:Class="Centinela.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Centinela.App"
        Title="Centinela" Width="1280" Height="800" Background="#111" KeyDown="Window_KeyDown">
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Importar JSON…" Click="Import_Click"/>
                <MenuItem Header="_Exportar JSON…" Click="Export_Click"/>
                <MenuItem Header="_Carpeta de copia automática…" Click="BackupFolder_Click"/>
                <Separator/>
                <MenuItem Header="_Salir" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Ver">
                <MenuItem x:Name="ShowStatsItem" Header="Mostrar _estadísticas" IsCheckable="True" Click="ShowStats_Click"/>
                <Separator/>
                <MenuItem Header="_Opciones de avisos…" Click="NotificationOptions_Click"/>
            </MenuItem>
            <MenuItem x:Name="HelpMenu" Header="A_yuda">
                <MenuItem Header="_Manual" Click="Manual_Click"/>
                <MenuItem Header="_Licencia" Click="License_Click"/>
                <MenuItem Header="_Soporte" Click="Support_Click"/>
                <Separator/>
                <MenuItem Header="_Buscar actualizaciones…" Click="Updates_Click"/>
                <MenuItem Header="_Acerca de Centinela" Click="About_Click"/>
            </MenuItem>
        </Menu>
        <ToolBarTray x:Name="TopBar" DockPanel.Dock="Top">
            <ToolBar x:Name="MainToolBar">
                <Button Content="➕ Añadir cámara" Click="AddCamera_Click"/>
                <Button Content="🔍 Buscar en red" Click="Discover_Click"/>
                <Separator/>
                <TextBlock Text="Vista:" VerticalAlignment="Center" Margin="4,0"/>
                <ComboBox x:Name="GridModeBox" MinWidth="240">
                    <ComboBoxItem Content="Auto"/>
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="9"/>
                    <ComboBoxItem Content="16"/>
                    <ComboBoxItem Content="Principal + miniaturas (derecha)"/>
                    <ComboBoxItem Content="Principal + miniaturas (izquierda)"/>
                    <ComboBoxItem Content="Dos principales + miniaturas"/>
                </ComboBox>
                <Separator/>
                <Button Content="📁 Grabaciones" Click="OpenRecordings_Click"/>
                <Button x:Name="RecordAllButton" Content="⏺ Grabar todas" Click="RecordAll_Click"/>
            </ToolBar>
        </ToolBarTray>
        <StatusBar x:Name="BottomBar" DockPanel.Dock="Bottom">
            <StatusBarItem DockPanel.Dock="Right" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="MotionLogButton" Content="Movimiento" Padding="8,0" Margin="0,0,6,0"
                            ToolTip="Registro de movimiento" Click="OpenMotionLog_Click"/>
                    <Button x:Name="LogButton" Content="Registro" Padding="8,0" ToolTip="Registro de errores" Click="OpenLog_Click"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Cursor="Hand" MouseLeftButtonUp="StatusText_Click"/>
            </StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid x:Name="TileGrid"/>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No hay cámaras" Foreground="#AAA" FontSize="20" HorizontalAlignment="Center"/>
                <Button Content="Añade tu primera cámara" Margin="0,12,0,0" Padding="12,6" Click="AddCamera_Click"/>
            </StackPanel>
            <local:ToastHost x:Name="Toasts"/>
        </Grid>
    </DockPanel>
</Window>
