<Window x:Class="Centinela.App.NotificationOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Centinela.App"
        Title="Opciones de avisos" Width="820" Height="520" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Aceptar" IsDefault="True" Width="90" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Cancelar" IsCancel="True" Width="90"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <CheckBox x:Name="SoundLostBox" Content="Sonar al perder una conexión" Margin="0,0,0,6"/>
            <CheckBox x:Name="SoundMotionBox" Content="Sonar al detectar movimiento" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="QuietBox" Content="Horas de silencio" VerticalAlignment="Center"/>
                <TextBlock Text="desde" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <TextBox x:Name="QuietFromBox" Width="60" MaxLength="5" VerticalContentAlignment="Center"
                         ToolTip="Hora con formato HH:mm (por ejemplo 23:00)" TextChanged="Time_Changed"/>
                <TextBlock Text="hasta" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <TextBox x:Name="QuietToBox" Width="60" MaxLength="5" VerticalContentAlignment="Center"
                         ToolTip="Hora con formato HH:mm (por ejemplo 07:00)" TextChanged="Time_Changed"/>
            </StackPanel>
            <TextBlock x:Name="Error" Foreground="Red" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,0"
                       Text="La detección mantiene abierta la conexión de baja calidad de cada cámara vigilada, también con la app en la bandeja."/>
        </StackPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cámara" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                <DataGridTemplateColumn Header="Detección" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding MotionEnabled, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Sensibilidad" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox MinWidth="80" ItemsSource="{x:Static local:NotificationOptionsWindow.Sensitivities}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Sensitivity, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Espera" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox MinWidth="80" ItemsSource="{x:Static local:NotificationOptionsWindow.Cooldowns}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding CooldownSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Avisos de conexión" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding ConnectionAlerts, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Avisos de movimiento" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding MotionAlerts, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
