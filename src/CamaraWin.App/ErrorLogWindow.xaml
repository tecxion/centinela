<Window x:Class="CamaraWin.App.ErrorLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de errores" Width="900" Height="480"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Copiar" Padding="10,4" Margin="0,0,8,0" Click="Copy_Click"
                    ToolTip="Copia las filas seleccionadas (o todas si no hay ninguna seleccionada)"/>
            <Button Content="Abrir carpeta" Padding="10,4" Margin="0,0,8,0" Click="OpenFolder_Click"/>
            <Button Content="Limpiar" Padding="10,4" Click="Clear_Click"
                    ToolTip="Vacía la lista; los archivos de registro se conservan"/>
        </StackPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Hora" Binding="{Binding Time, StringFormat='dd/MM HH:mm:ss'}" Width="Auto"/>
                <DataGridTextColumn Header="Cámara" Binding="{Binding Camera}" Width="Auto"/>
                <DataGridTextColumn Header="Error" Binding="{Binding Kind}" Width="Auto"/>
                <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="Auto"/>
                <DataGridTextColumn Header="Detalle" Binding="{Binding Detail}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
